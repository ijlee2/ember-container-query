{
  "extends": "@shared-configs/typescript/ember-addon",
  "compilerOptions": {
    "declarationDir": "declarations",
    "plugins": [
      {
        "name": "@glint/tsserver-plugin"
      }
    ],
    "rootDir": ".",
    "types": ["@glint/ember-tsc/types", "ember-source/types"]
  },
  "include": ["src/**/*", "unpublished-development-types/**/*", "*.mts"]
}
